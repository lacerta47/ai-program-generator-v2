# 이 파일은 필요한 환경변수의 "목록"입니다 (값은 비워둠, git에 커밋 OK).
# 실제 값은 .env.local 에 넣으세요 (.env.local 은 git 제외됨).

# --- Gemini (서버 전용) ---
# 티어 분리(권장): 사용자 요청은 유료(학습 미사용), 내부 자동 예시 생성은 무료로.
#   GEMINI_API_KEY_PAID = 결제(빌링) 켜진 GCP 프로젝트의 키 → 사용자 /api/generate 전용
#   GEMINI_API_KEY_FREE = 결제 없는 프로젝트의 키 → 자동 예시 생성(cron) 전용
# 둘 중 하나라도 없으면 아래 GEMINI_API_KEY(단일 키)로 폴백한다(기존 호환).
GEMINI_API_KEY_PAID=
GEMINI_API_KEY_FREE=
GEMINI_API_KEY=

# BizRouter는 명시적으로 선택할 때만 사용. free 자동 예시는 Gemini 유지.
AI_PROVIDER=bizrouter-first
# 두 키를 같은 환경에 등록한 뒤 사용. BizRouter가 가득 차면 Gemini로 초과분 분산.
# AI_PROVIDER=split은 비교 시험용 50:50 배정. 자동 예시는 기존 Gemini 경로 유지.
GEN_GEMINI_CONCURRENCY=4
GEN_BIZROUTER_CONCURRENCY=4
BIZROUTER_API_KEY=
# 선택: 두 번째 키. 두 키가 BizRouter 전체 동시 슬롯 4개를 나눠 사용.
BIZROUTER_API_KEY_2=
# 키에서 허용된 모델 ID를 지정(예: google/gemini-3.8-flash). 실제 접근 가능 여부 확인 필요.
BIZROUTER_MODEL=google/gemini-3.8-flash
# 복잡 유형 전용 모델(비워두면 BIZROUTER_MODEL 사용).
BIZROUTER_HIGH_MODEL=google/gemini-4-argon

# --- Firebase 클라이언트 (NEXT_PUBLIC_ 접두사 = 브라우저 노출됨, 정상) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (서버 전용, 절대 NEXT_PUBLIC 금지) ---
# 서비스계정 JSON 전체를 한 줄 문자열로 넣거나, 파일 경로 방식 중 택1 (추후 확정)
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- 미리보기 프로세스 격리 (프로덕션 필수) ---
# 생성 코드 미리보기를 "다른 오리진"에서 실행해 무한루프가 메인 탭을 얼리지 못하게 막는 장치.
# 로컬은 localhost↔127.0.0.1 스왑으로 자동 처리되지만, 배포 시엔 별도 미리보기 도메인을 지정해야 함.
# 미설정·동일 출처 설정 시 미리보기가 거부됨. 운영 앱과 다른 사이트를 지정할 것.
# 예: https://ai-program-generator-v2-preview.vercel.app
NEXT_PUBLIC_PREVIEW_ORIGIN=

# 앱(프로덕션) 오리진 — 미리보기 iframe의 frame-ancestors 허용목록에 쓰임. 커스텀 도메인/도메인 변경 시
# 실제 앱 주소로 설정(미설정 시 eduai-lun.co.kr 폴백). 예: https://eduai-lun.co.kr
NEXT_PUBLIC_APP_ORIGIN=

# --- Cron 보호 (배포 시 필수) ---
# 만료된 previews 정리 cron(/api/cron/cleanup-previews)을 보호하는 시크릿.
# Vercel Cron은 이 값을 Authorization: Bearer 헤더로 자동 전송. 길고 랜덤한 문자열로.
# 미설정 시 cron 라우트는 500으로 거부(우발적 무방비 노출 방지).
CRON_SECRET=

# --- App Check (reCAPTCHA v3) ---
# 사이트 키(공개, NEXT_PUBLIC OK). 미설정 시 코드 하드코딩 폴백 사용. 프로덕션 브라우저에서만 App Check 활성.
NEXT_PUBLIC_APPCHECK_RECAPTCHA_KEY=
# 로컬 dev 브라우저용 디버그 토큰(App Check 콘솔에서 발급). dev 전용 — 프로덕션엔 넣지 말 것.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- 생성 쿼터/레이트리밋 튜닝 (선택 — 모두 폴백 있어 미설정 시 크래시 없음) ---
# 일반 회원 총 생성 상한(기본 5). config/usage.totalLimit, limits/{uid}.totalLimit으로 조정 가능.
GEN_TOTAL_LIMIT=
# 교사·admin 일일 생성 상한(기본 100).
ROLE_GEN_DAILY_LIMIT=
# uid별 생성 시작 레이트리밋 — 10분 창당 최대 시작 횟수(기본 30). abort-파밍/DoS 상한.
GEN_RATE_MAX=
